# ---- Server ----
PORT=5000
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# ---- Supabase Postgres (Project Settings -> Database -> Connection string) ----
# Use the "Session pooler" string (works on IPv4 networks). If your password has special
# characters (@ : / # ?) URL-encode them, e.g. @ becomes %40.
DATABASE_URL=postgresql://postgres.YOURPROJECTREF:YOURPASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---- Supabase Storage for images (Project Settings -> API) ----
# Leave both blank to store images locally in backend/uploads (development only).
SUPABASE_URL=https://YOURPROJECTREF.supabase.co
# The *service_role* key. SECRET: server only, never put it in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=made-in-rwanda

# ---- Payments: only "simulated" is implemented (no real money) ----
PAYMENT_PROVIDER=simulated

# ---- Seed script (npm run seed). Leave passwords blank to auto-generate and print once ----
SEED_ADMIN_EMAIL=admin@madeinrwanda.rw
SEED_ADMIN_PASSWORD=
SEED_MANAGER_EMAIL=manager@madeinrwanda.rw
SEED_MANAGER_PASSWORD=
SEED_SAMPLE_PASSWORD=
